# =============================================================================
# Binance Pay Auditor — Variables de Entorno
# =============================================================================
# Copiá este archivo a .env y editá las contraseñas antes de docker compose up.
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d
# =============================================================================

# ---- PostgreSQL ----
DB_USER=auditor
DB_PASSWORD=cambia-esta-contraseña-por-algo-seguro
DB_NAME=auditor_db
DB_PORT=5432

# ---- JWT ----
# Mínimo 32 caracteres. Generá uno con: openssl rand -base64 32
JWT_SECRET=cambia-esta-clave-jwt-por-32-caracteres-o-mas

# ---- Servidor ----
# Puerto en el host donde escucha la API
LISTEN_PORT=8443

# Cada cuántos segundos sincroniza con Gmail IMAP (default: 300 = 5 min)
IMAP_POLL_INTERVAL_SECS=300

# ---- Logs ----
# Niveles: trace, debug, info, warn, error
RUST_LOG=binance_auditor_server=info,tower_http=info
