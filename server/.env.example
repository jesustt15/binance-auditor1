# =============================================================================
# Binance Pay Auditor — Variables de Entorno
# =============================================================================
# Copiá este archivo a .env y editá las contraseñas antes de docker compose up.
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d
# =============================================================================

# ---- PostgreSQL ----
DB_USER=auditor
DB_PASSWORD=cambia-esta-contraseña-por-algo-seguro
DB_NAME=auditor_db
DB_PORT=5432

# ---- JWT ----
# Si no se configura, el servidor genera uno aleatorio y lo guarda en
# %APPDATA%/binance-auditor-server/jwt_secret. Respaldalo.
# Para generar uno manual: openssl rand -hex 32
# JWT_SECRET=

# ---- Seguridad ----
# Orígenes CORS permitidos (separados por coma). Restringe esto en producción
# a la IP o dominio exacto del servidor + el origen de Tauri.
CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost

# ---- Servidor ----
# Puerto en el host donde escucha la API
LISTEN_PORT=8443

# Cada cuántos segundos sincroniza con Gmail IMAP (default: 300 = 5 min)
IMAP_POLL_INTERVAL_SECS=300

# ---- Logs ----
# Niveles: trace, debug, info, warn, error
RUST_LOG=binance_auditor_server=info,tower_http=info
# Formato: "pretty" (texto coloreado) o "json" (para Loki/Elastic)
RUST_LOG_FORMAT=pretty
